# ============================================================
# KURO Phase 5 — Environment Variables
# Rename this file to .env and fill in your values
# NEVER commit the actual .env file
# ============================================================

# ── Groq API (Primary LLM — fast cloud) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Cloud LLM (OpenRouter — fallback for code/DSA tasks) ─────────────────────
CLOUD_API_URL=https://openrouter.ai/api/v1/chat/completions
CLOUD_API_KEY=sk-or-v1-YOUR_KEY_HERE
CLOUD_MODEL=qwen/qwen3-coder:free

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
# Main local brain for 6GB VRAM systems.
# First run pulls automatically in start.ps1: ollama pull gemma4:e2b
LOCAL_MODEL=gemma4:e2b
# Local model fallback used by some legacy codepaths.
FALLBACK_MODEL=gemma4:e2b
EMBED_MODEL=nomic-embed-text
# Reasoner backend policy:
# local = local only, groq = cloud only, auto = local first then Groq fallback.
LLM_BACKEND=auto

# Speed mode: disable cloud routing (max speed, never call Groq)
FORCE_LOCAL=false

# ── Ollama service endpoint ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# Ollama speed knobs
LOCAL_NUM_PREDICT=256
LOCAL_NUM_CTX=2048
LOCAL_TEMPERATURE=0.4
LOCAL_TOP_P=0.9

# ── Audio / VAD ───────────────────────────────────────────────────────────────
VAD_THRESHOLD=0.65          # Raised from 0.5 — ignores classroom/room noise
MIN_PHONATION_SEC=0.4       # Discard audio shorter than this (prevents hallucinations)
STT_BEAM_WIDTH=3            # Whisper beam width (accuracy vs speed)
STT_DEVICE=cuda
STT_BACKEND=groq
STT_SILENCE_MS=350
STT_VAD_THRESHOLD=0.65
STT_PRE_SPEECH_MS=200
STT_MAX_RECORD_SECONDS=12
STT_INITIAL_TIMEOUT_S=4.0
STT_USE_NOISE_REDUCE=false  # Disabled for fastest direct speech pickup
STT_VOICE_ENERGY_MAX=200
STT_MIN_RMS=0
STT_IDLE_TIMEOUT_S=6.0
STT_TRANSCRIBE_TIMEOUT_S=20.0
STT_NO_SPEECH_THRESHOLD=0.20
STT_ENDPOINT_ACTIVITY_MULT=0.72
STT_ENDPOINT_ACTIVITY_OFFSET=25
VAD_SILENCE_THRESHOLD_MS=500

# ── Vision (Privacy Tunnel) ───────────────────────────────────────────────────
VISION_ENABLED=true
SEND_PIXELS_TO_CLOUD=false  # ALWAYS false — only JSON element labels go to Groq

# ── Performance ───────────────────────────────────────────────────────────────
PROCESS_PRIORITY=high
PCORES_ONLY=true            # Pin to P-cores 0-7 on i5-12500H

# ── Picovoice (Porcupine wake word) ──────────────────────────────────────────
PICOVOICE_KEY=

# ── Legacy (kept for compatibility) ───────────────────────────────────────────
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.0\blender.exe
BLENDER_WATCH_DIR=data/blender_watch
APP_PORT=7860
APP_DEBUG=false
LOG_LEVEL=INFO
WHISPER_MODEL=base.en
WHISPER_BEAM_SIZE=1
